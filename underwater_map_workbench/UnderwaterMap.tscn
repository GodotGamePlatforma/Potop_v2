metadata/runtime = {"barrier_groups": [{"id": "red_route", "members": [{"open_offset": [0, -160], "socket_id": "gate_red_west"}, {"open_offset": [0, -160], "socket_id": "gate_red_east"}], "travel_speed": 320}, {"id": "blue_route", "members": [{"open_offset": [-160, 0], "socket_id": "gate_blue_upper"}, {"open_offset": [-160, 0], "socket_id": "gate_blue_lower"}], "travel_speed": 320}, {"id": "yellow_route", "members": [{"open_offset": [-160, 0], "socket_id": "gate_yellow"}], "travel_speed": 320}, {"id": "shortcut_b", "members": [{"open_offset": [-160, 0], "socket_id": "shortcut_b_upper"}, {"open_offset": [-160, 0], "socket_id": "shortcut_b_lower"}], "travel_speed": 320}, {"id": "shortcut_c", "members": [{"open_offset": [160, 0], "socket_id": "shortcut_c_upper"}, {"open_offset": [160, 0], "socket_id": "shortcut_c_middle"}, {"open_offset": [160, 0], "socket_id": "shortcut_c_lower"}], "travel_speed": 320}, {"id": "hatch_d", "members": [{"open_offset": [-160, 0], "socket_id": "hatch_d"}], "travel_speed": 320}, {"id": "hatch_basement", "members": [{"open_offset": [-160, 0], "socket_id": "hatch_basement"}], "travel_speed": 320}], "contract": "enterable_tower_sequence_v3", "elevator": {"cabin_size": [464, 200], "id": "elevator_main", "initial_stop_id": "floor_12", "socket_id": "elevator_upper_travel", "stops": [{"id": "floor_12", "local_center": [1280, 180]}, {"id": "floor_7", "local_center": [1280, 1580]}], "travel_speed": 240}, "interactives": [{"display_name": "Rozdzielnia A", "id": "a_distributor", "interaction_action": "activate", "interaction_seconds": 1, "kind": "power_distributor", "power_logic": {"circuits": {"blue": {"barrier_group_id": "blue_route", "positions": ["up", "down", "up"], "symbol": "triangle"}, "red": {"barrier_group_id": "red_route", "positions": ["down", "down", "down"], "symbol": "circle"}, "yellow": {"barrier_group_id": "yellow_route", "positions": ["down", "up", "up"], "symbol": "square"}}, "clue_summaries": {"blue": "BLUE • TYLKO ŚRODKOWA GAŁĄŹ", "red": "RED • TRZY GAŁĘZIE DOMKNIĘTE", "yellow": "YELLOW • 1 DOMK.; ŚRODEK ZAJ.; PRAWA ODC."}, "clues": {"blue": "WÓZEK TECHNICZNY: tylko gałąź środkowa domyka tor serwisowy.", "red": "OBWÓD AWARYJNY: pozycja dolna domyka gałąź; wymagane są trzy domknięte gałęzie.", "yellow": "INSTALACJA CIŚNIENIOWA: jedna gałąź pozostaje domknięta; środkowa jest zajęta, prawa odcięta."}, "contract": "three_lever_deduction_v2", "diagnostics": {"all_branches_open": {"message": "PRZERWA: żadna gałąź nie domyka obwodu.", "positions": ["up", "up", "up"], "summary": "PRZERWA • ŻADNA GAŁĄŹ"}, "left_middle_crossfeed": {"message": "SPRZĘŻENIE: gałęzie lewa i środkowa zwierają tor sterujący.", "positions": ["down", "down", "up"], "summary": "SPRZĘŻENIE • LEWA + ŚRODEK"}, "middle_right_overload": {"message": "PRZECIĄŻENIE: gałęzie środkowa i prawa obciążają wspólną szynę.", "positions": ["up", "down", "down"], "summary": "PRZECIĄŻENIE • ŚRODEK + PRAWA"}, "right_branch_unterminated": {"message": "PRAWA GAŁĄŹ: brak dostępnego odbiornika.", "positions": ["up", "up", "down"], "summary": "PRAWA • BRAK ODBIORNIKA"}, "split_outer_feed": {"message": "ROZDZIAŁ ZASILANIA: dwie skrajne gałęzie tworzą nieciągły tor.", "positions": ["down", "up", "down"], "summary": "ROZDZIAŁ • SKRAJNE NIECIĄGŁE"}}, "evaluation": "on_toggle", "levers": [{"display_name": "Dźwignia A1", "id": "a_lever_1", "initial_position": "up", "local_rect": [1776, 720, 72, 72]}, {"display_name": "Dźwignia A2", "id": "a_lever_2", "initial_position": "up", "local_rect": [1884, 720, 72, 72]}, {"display_name": "Dźwignia A3", "id": "a_lever_3", "initial_position": "up", "local_rect": [1992, 720, 72, 72]}]}, "socket_id": "control_a_distributor"}, {"display_name": "Przekaźnik RED B", "id": "b_red_relay", "interaction_action": "latch", "interaction_seconds": 1, "kind": "red_relay", "socket_id": "control_b_red_relay", "visual_role": "red_relay_bank"}, {"display_name": "Blokada BLUE C", "id": "c_blue_lock", "interaction_action": "lock", "interaction_seconds": 1, "kind": "blue_lock", "socket_id": "control_c_blue_lock", "visual_role": "trolley_interlock"}, {"display_name": "Wyrównanie ciśnienia", "id": "d_valve_v1", "interaction_action": "turn", "interaction_seconds": 0.8, "kind": "d_valve", "socket_id": "control_d_valve_v1", "step": 1, "visual_role": "pressure_equalization"}, {"display_name": "Zasilenie siłownika", "id": "d_valve_v2", "interaction_action": "turn", "interaction_seconds": 0.8, "kind": "d_valve", "socket_id": "control_d_valve_v2", "step": 2, "visual_role": "actuator_power"}, {"display_name": "Zwolnienie rygla", "id": "d_valve_v3", "interaction_action": "turn", "interaction_seconds": 0.8, "kind": "d_valve", "socket_id": "control_d_valve_v3", "step": 3, "visual_role": "bolt_release"}, {"display_name": "Reset układu D", "id": "d_reset", "interaction_action": "reset", "interaction_seconds": 0.8, "kind": "d_reset", "socket_id": "control_d_reset", "visual_role": "d_reset_guard"}, {"display_name": "Sterowanie wejścia do Archiwum", "id": "basement_hatch_control", "interaction_action": "open", "interaction_seconds": 1, "kind": "basement_hatch_control", "socket_id": "control_basement_hatch", "visual_role": "archive_access"}]}

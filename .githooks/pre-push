#!/bin/sh

# Local policy guard from ARD-0108. Remote branch protection remains the
# authoritative enforcement layer; this hook intentionally fails closed.

remote_name=${1:-unknown}
remote_url=${2:-unknown}
rejected=0

is_zero_oid() {
    case "$1" in
        ''|*[!0]*) return 1 ;;
        *) return 0 ;;
    esac
}

reject_update() {
    printf '%s\n' "PRE-PUSH REJECTED: $1" >&2
    rejected=1
}

is_fast_forward_update() {
    old_oid=$1
    new_oid=$2

    if is_zero_oid "$old_oid"; then
        return 0
    fi

    git merge-base --is-ancestor "$old_oid" "$new_oid" >/dev/null 2>&1
}

while read -r local_ref local_oid remote_ref remote_oid
do
    if [ -z "$remote_ref" ]; then
        reject_update "niekompletny rekord aktualizacji dla remote '$remote_name' ($remote_url)."
        continue
    fi

    if is_zero_oid "$local_oid"; then
        reject_update "kasowanie '$remote_ref' jest zabronione przez lokalny kontrakt agentow."
        continue
    fi

    case "$remote_ref" in
        refs/heads/codex/?*)
            if ! is_fast_forward_update "$remote_oid" "$local_oid"; then
                reject_update "'$remote_ref' nie jest fast-forward; po hand-offie nie wolno force-pushowac ani przepisywac historii codex/*."
            fi
            ;;

        refs/heads/main|refs/heads/master)
            if [ "${CODEX_INTEGRATOR_ALLOW_MAIN_PUSH:-0}" != "1" ]; then
                reject_update "bezposredni push do '$remote_ref' jest zarezerwowany dla integratora. Agenci pushuja wylacznie refs/heads/codex/*."
                continue
            fi

            printf '%s\n' "INTEGRATOR BYPASS: dopuszczam '$remote_ref'. Ten tryb wymaga osobnego, zweryfikowanego run receiptu; hook go nie parsuje ani nie potwierdza." >&2
            if ! is_fast_forward_update "$remote_oid" "$local_oid"; then
                reject_update "nawet tryb integratora nie dopuszcza non-fast-forward dla '$remote_ref'."
            fi
            ;;

        *)
            reject_update "'$remote_ref' jest poza dozwolonym refs/heads/codex/* (inne galezie i tagi sa zabronione)."
            ;;
    esac
done

if [ "$rejected" -ne 0 ]; then
    printf '%s\n' "Push zatrzymany lokalnie. Popraw ref/historie albo wykonaj zweryfikowana procedure integratora." >&2
    exit 1
fi

exit 0

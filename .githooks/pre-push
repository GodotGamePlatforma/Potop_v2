#!/bin/sh

# Agents may publish only codex/* branches. Direct main/master updates and
# deletions are always rejected. The exact stdin stream is then forwarded to
# Git LFS so this policy never replaces the standard LFS pre-push contract.

remote_name=${1:-origin}
remote_url=${2:-unknown}
updates_file=

cleanup() {
    if [ -n "$updates_file" ]; then
        rm -f -- "$updates_file"
    fi
}

trap cleanup EXIT
trap 'exit 1' HUP INT TERM
umask 077

updates_file=$(mktemp "${TMPDIR:-/tmp}/potop-pre-push.XXXXXX") || {
    printf '%s\n' "PRE-PUSH REJECTED: nie można zapisać rekordów push." >&2
    exit 1
}
cat > "$updates_file" || {
    printf '%s\n' "PRE-PUSH REJECTED: nie można odczytać rekordów push." >&2
    exit 1
}

rejected=0
while read -r local_ref local_oid remote_ref remote_oid
do
    if [ -z "$remote_ref" ]; then
        printf '%s\n' "PRE-PUSH REJECTED: niekompletny rekord aktualizacji." >&2
        rejected=1
        continue
    fi

    case "$local_oid" in
        ''|*[!0]*) ;;
        *)
            printf '%s\n' "PRE-PUSH REJECTED: kasowanie '$remote_ref' jest zabronione." >&2
            rejected=1
            continue
            ;;
    esac

    case "$remote_ref" in
        refs/heads/main|refs/heads/master)
            printf '%s\n' "PRE-PUSH REJECTED: bezpośredni push do '$remote_ref' jest zabroniony." >&2
            rejected=1
            ;;
        refs/heads/codex/?*)
            ;;
        *)
            printf '%s\n' "PRE-PUSH REJECTED: agent może publikować wyłącznie refs/heads/codex/*." >&2
            rejected=1
            ;;
    esac
done < "$updates_file"

if [ "$rejected" -ne 0 ]; then
    exit 1
fi

if ! command -v git-lfs >/dev/null 2>&1; then
    printf '%s\n' "PRE-PUSH REJECTED: Git LFS nie jest dostępny." >&2
    exit 1
fi

if ! git lfs pre-push "$remote_name" "$remote_url" < "$updates_file"; then
    printf '%s\n' "PRE-PUSH REJECTED: git lfs pre-push zakończył się błędem." >&2
    exit 1
fi

exit 0

[resource]
script = ExtResource("1_building")
id = "fishing_hut"
display_name = "Chata Rybacka"
description = "Zdolna obsada dostarcza jedzenie na koniec dnia, zwiększając przy tym presję na lokalne łowisko."
max_level = 4
requires_edge = true
levels = Array[Resource]([SubResource("Level1"), SubResource("Level2"), SubResource("Level3"), SubResource("Level4")])
specialist_bonus = {"profession": "rybak", "production_bonus": 1}

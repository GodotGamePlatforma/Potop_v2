[gd_resource type="Resource" load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/definitions/SettlementEventDefinition.gd" id="1_event"]
[ext_resource type="Script" path="res://scripts/definitions/SettlementEventChoiceDefinition.gd" id="2_choice"]

[sub_resource type="Resource" id="ChoiceScrap"]
script = ExtResource("2_choice")
id = "repair_with_scrap"
label = "ZAŁÓŻ STALOWĄ OBEJMĘ"
preview = "Złom -3  •  Integralność +14"
result_text = "Nowa obejma trzyma mocno. Pomost przestaje szarpać przy każdym uderzeniu fali."
resource_deltas = {"platform_integrity": 14, "scrap": -3}
impact_tags = Array[String](["material_cost", "integrity_relief"])

[sub_resource type="Resource" id="ChoicePlanks"]
script = ExtResource("2_choice")
id = "brace_with_planks"
label = "PODEPRZYJ WĘZEŁ DESKAMI"
preview = "Deski -4  •  Integralność +8"
result_text = "Drewniane zastrzały nie są piękne, ale rozkładają napór na większą część platformy."
resource_deltas = {"planks": -4, "platform_integrity": 8}
impact_tags = Array[String](["material_cost", "integrity_relief"])

[sub_resource type="Resource" id="ChoiceDelay"]
script = ExtResource("2_choice")
id = "delay_repair"
label = "TYLKO DOCIĄGNIJ LINY"
preview = "Integralność -6  •  Nadzieja -2"
result_text = "Liny wytrzymają jeszcze trochę, lecz każdy słyszy jęk pękającej konstrukcji."
resource_deltas = {"hope": -2, "platform_integrity": -6}
impact_tags = Array[String](["integrity_risk", "hope_change"])

[resource]
script = ExtResource("1_event")
id = "torn_mooring"
history_key = "torn_mooring"
category = "platform"
title = "PĘKNIĘTE CUMOWANIE"
body = "Nocne kołysanie wyrwało jeden z głównych węzłów. Możemy naprawić go od razu albo zaryzykować prowizoryczne zabezpieczenie."
base_weight = 9.0
tone = "hardship"
severity = 2
pressure_cost = 1.5
minimum_day = 3
cooldown_days = 4
cooldown_group = "platform_hardship"
allow_during_crisis = true
trigger_tags = Array[String](["low_integrity"])
impact_tags = Array[String](["material_cost", "integrity_risk", "integrity_relief", "hope_change"])
exclusive_tags = Array[String](["integrity_critical", "recent_death", "storm_today"])
recovery_role = "none"
fallback_choice_id = "delay_repair"
choices = Array[Resource]([SubResource("ChoiceScrap"), SubResource("ChoicePlanks"), SubResource("ChoiceDelay")])

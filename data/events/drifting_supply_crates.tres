[resource]
script = ExtResource("1_event")
id = "drifting_supply_crates"
history_key = "drifting_supply_crates"
category = "supplies"
title = "ŁADUNEK W DRYFIE"
body = "Prąd przynosi resztki platformy transportowej. Zanim konstrukcja zatonie, zdążymy zabezpieczyć tylko jedną część ładunku."
base_weight = 10.0
tone = "relief"
severity = 1
pressure_cost = 0.0
minimum_day = 3
cooldown_days = 4
cooldown_group = "supply_opportunity"
allow_during_crisis = true
trigger_tags = Array[String](["food_need", "material_need"])
impact_tags = Array[String](["food_relief", "material_relief"])
exclusive_tags = Array[String]([])
recovery_role = "food"
fallback_choice_id = "recover_food"
choices = Array[Resource]([SubResource("ChoiceFood"), SubResource("ChoiceMaterials")])

[gd_resource type="Resource" load_steps=4 format=3]

[ext_resource type="Script" path="res://scripts/definitions/SettlementEventDefinition.gd" id="1_event"]
[ext_resource type="Script" path="res://scripts/definitions/SettlementEventChoiceDefinition.gd" id="2_choice"]

[sub_resource type="Resource" id="ChoiceMeal"]
script = ExtResource("2_choice")
id = "hold_meal"
label = "ZORGANIZUJ WSPÓLNY POSIŁEK"
preview = "Jedzenie -8  •  Nadzieja +9"
result_text = "Przez jeden wieczór nikt nie je samotnie. Rozmowy trwają dłużej niż płomień pod kotłem."
resource_deltas = {"food": -8, "hope": 9}
impact_tags = Array[String](["hope_relief", "food_cost"])

[sub_resource type="Resource" id="ChoiceSaveFood"]
script = ExtResource("2_choice")
id = "save_food"
label = "ZACHOWAJ ZAPASY"
preview = "Nadzieja -3"
result_text = "Racje zostają zamknięte w magazynie. Głód nie rośnie, lecz rozczarowanie jest wyraźne."
resource_deltas = {"hope": -3}
impact_tags = Array[String](["hope_change"])

[resource]
script = ExtResource("1_event")
id = "shared_meal"
history_key = "shared_meal"
category = "society"
title = "PROŚBA O WSPÓLNY STÓŁ"
body = "Mieszkańcy proszą, by choć raz odłożyć pracę i podzielić się lepszym posiłkiem. Zapasy nie są niewyczerpane, ale napięcie w osadzie rośnie."
base_weight = 8.0
tone = "relief"
severity = 1
pressure_cost = 0.5
minimum_day = 3
cooldown_days = 5
cooldown_group = "social_relief"
allow_during_crisis = true
required_resource_minimums = {"food": 8}
trigger_tags = Array[String](["low_hope", "food_surplus"])
impact_tags = Array[String](["hope_relief", "food_cost", "hope_change"])
exclusive_tags = Array[String](["food_critical"])
recovery_role = "hope"
fallback_choice_id = "save_food"
choices = Array[Resource]([SubResource("ChoiceMeal"), SubResource("ChoiceSaveFood")])

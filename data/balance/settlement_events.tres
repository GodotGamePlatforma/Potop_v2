[sub_resource type="Resource" id="PopulationRule"]
script = ExtResource("2_rule")
trigger_tag = "population_need"
event_probability_bonus = 0.08
bonus_activation_multiplier = 3.0
required_available_impact_tags = Array[String](["workforce_relief", "population_gain"])
curves = Array[Resource]([SubResource("PopulationWorkersCurve"), SubResource("PopulationShelterCurve"), SubResource("PopulationFoodCurve")])


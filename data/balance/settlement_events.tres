[resource]
script = ExtResource("1_balance")
balance_id = "settlement_events_v1"
balance_version = 1
minimum_event_day = 3
fallback_quiet_day_percentage = 45.0
minimum_event_probability = 0.25
maximum_event_probability = 0.8
maximum_need_probability_bonus = 0.2
minimum_weight_multiplier = 0.1
maximum_weight_multiplier = 5.5
force_workforce_recovery = true
critical_alive_maximum = 2
critical_healthy_workers_maximum = 1
forced_minimum_food_days = 0.75
forced_minimum_free_shelter = 2
forced_recovery_role = "workforce"
recovery_safe_tones = Array[String](["relief", "opportunity"])
recovery_match_weight_multiplier = 2.4
preferred_impact_weight_multiplier = 1.35
trigger_rules = Array[Resource]([SubResource("PopulationRule"), SubResource("FoodNeedRule"), SubResource("MaterialsNeedRule"), SubResource("IntegrityNeedRule"), SubResource("HopeNeedRule"), SubResource("FoodSurplusRule"), SubResource("MedicineNeedRule")])

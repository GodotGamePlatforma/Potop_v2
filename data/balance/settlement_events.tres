[gd_resource type="Resource" load_steps=45 format=3]

[ext_resource type="Script" path="res://scripts/definitions/SettlementEventBalanceDefinition.gd" id="1_balance"]
[ext_resource type="Script" path="res://scripts/definitions/SettlementEventWeightRuleDefinition.gd" id="2_rule"]
[ext_resource type="Script" path="res://scripts/definitions/SettlementEventWeightCurveDefinition.gd" id="3_curve"]
[ext_resource type="Script" path="res://scripts/definitions/SettlementEventWeightBandDefinition.gd" id="4_band"]

[sub_resource type="Resource" id="PopulationWorkersCritical"]
script = ExtResource("4_band")
label = "healthy_workers <= 1"
maximum_enabled = true
maximum_value = 1.0
maximum_inclusive = true
multiplier = 8.0

[sub_resource type="Resource" id="PopulationWorkersLow"]
script = ExtResource("4_band")
label = "1 < healthy_workers <= 2"
minimum_enabled = true
minimum_value = 1.0
minimum_inclusive = false
maximum_enabled = true
maximum_value = 2.0
maximum_inclusive = true
multiplier = 4.0

[sub_resource type="Resource" id="PopulationWorkersLimited"]
script = ExtResource("4_band")
label = "2 < healthy_workers <= 3"
minimum_enabled = true
minimum_value = 2.0
minimum_inclusive = false
maximum_enabled = true
maximum_value = 3.0
maximum_inclusive = true
multiplier = 1.6

[sub_resource type="Resource" id="PopulationWorkersCurve"]
script = ExtResource("3_curve")
metric = "healthy_workers"
fallback_multiplier = 0.55
bands = Array[Resource]([SubResource("PopulationWorkersCritical"), SubResource("PopulationWorkersLow"), SubResource("PopulationWorkersLimited")])

[sub_resource type="Resource" id="PopulationShelterAvailable"]
script = ExtResource("4_band")
label = "free_shelter >= 2"
minimum_enabled = true
minimum_value = 2.0
multiplier = 1.3

[sub_resource type="Resource" id="PopulationShelterFull"]
script = ExtResource("4_band")
label = "free_shelter <= 0"

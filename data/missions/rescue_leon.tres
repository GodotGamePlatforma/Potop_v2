[sub_resource type="Resource" id="RescueLeon"]
script = ExtResource("2_objective")
id = "rescue_hotel_leon"
kind = "rescue_outcome"
text = "Odnajdź i uratuj Leona Wronę."
description = "Uwolnij ocalałego, w razie potrzeby ustabilizuj go lekami i wróć z nim do liny. Jego śmierć oznacza niepowodzenie zadania."
target_id = "rescue_hotel_leon"
target_landmark_id = "R1-03"
landmark_label = "Zatopiony Hotel"
guidance = "W Zatopionym Hotelu (R1-03) czeka uwięziony Leon. Łom jest stałym narzędziem wyprawy; jeśli Leon będzie wymagał stabilizacji, znajdź pod wodą leki i zachowaj je w plecaku."

[resource]

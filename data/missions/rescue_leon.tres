[sub_resource type="Resource" id="RescueLeon"]
script = ExtResource("2_objective")
id = "rescue_leon"
kind = "rescue_outcome"
text = "Odnajdź i uratuj Leona Wronę."
description = "Uwolnij ocalałego, w razie potrzeby ustabilizuj go lekami i wróć z nim do liny. Jego śmierć oznacza niepowodzenie zadania."
target_id = "rescue_leon"
guidance = "Odnajdź uwięzionego Leona. Łom jest stałym narzędziem wyprawy; jeśli będzie wymagał stabilizacji, znajdź pod wodą leki i zachowaj je w plecaku."

[resource]
script = ExtResource("1_mission")
id = "rescue_leon"
category = "side"
title = "GŁOS SPOD WODY"
summary = "Odebrany sygnał wskazuje, że pod wodą wciąż czeka ocalały."
completion_text = "Leon bezpiecznie dotarł do Przystani."
failure_text = "Sygnał ratunkowy ucichł na zawsze."
sort_order = 110
unlock_kind = "tutorial_complete"
objectives = Array[Resource]([SubResource("RescueLeon")])
